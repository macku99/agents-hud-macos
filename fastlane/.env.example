# ─── Optional for `build` and `install` ─────────────────────────────
# The codesign identity, "Agents HUD Local" when unset — see README.md and
# `security find-identity -v -p codesigning`
# SIGNING_IDENTITY=Agents HUD Local

# ─── Fastlane runtime defaults ──────────────────────────────────────
FASTLANE_DONT_STORE_PASSWORD=true
FASTLANE_HIDE_CHANGELOG=true
FASTLANE_HIDE_GITHUB_ISSUES=true
